---
import '../styles/global.css';
import { hardSkillGroups, softSkills } from '../data/skills';

const projectCategories = [
  { id: 'networking', name: 'Networking & Infrastructure', face: 'front', color: '#2563a8', ink: '#fff', path: 'M108 230H240V390H80V258A28 28 0 0 1 108 230Z' },
  { id: 'frontend', name: 'Front-End Dev', face: 'front', color: '#f28a35', ink: '#281809', path: 'M240 390H400V522A28 28 0 0 1 372 550H240Z' },
  { id: 'electronics', name: 'Electronics', face: 'front', color: '#237142', ink: '#fff', path: 'M240 230H372A28 28 0 0 1 400 258V390H240Z' },
  { id: 'plc', name: 'PLC', face: 'front', color: '#5c6570', ink: '#fff', path: 'M80 390H240V550H108A28 28 0 0 1 80 522Z' },
  { id: 'cad', name: 'CAD Design', face: 'top', color: '#b83238', ink: '#fff', path: 'M315 155H475L390 240H230Z' },
];
const skillSections = [
  { id: 'hard-skills', title: 'Hard Skills', groups: hardSkillGroups },
  { id: 'soft-skills', title: 'Soft Skills', groups: [{ id: 'soft-skills-list', title: '', skills: softSkills }] },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Portafolio de Jorge Adrián Guillén Barraza. Proyectos, experiencia y habilidades." />
    <title>Jorge Adrián Guillén Barraza | Portafolio</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="#inicio">Ing. Jorge Adrián Guillén Barraza</a>
    </header>

    <main class="portfolio-grid" id="inicio">
      <aside class="profile-column" aria-labelledby="profile-heading">
        <div class="column-intro">
          <span class="eyebrow">Sobre mí</span>
          <h1 id="profile-heading">Hola, soy Jorge.</h1>
        </div>

        <div class="portrait-placeholder" role="img" aria-label="Retrato decorativo con las iniciales JG">
          <span class="portrait-initials" aria-hidden="true">JG</span>
        </div>

        <section class="side-section" aria-labelledby="links-heading">
          <h2 id="links-heading">Enlaces</h2>
          <div class="social-placeholders" aria-hidden="true">
            <span></span>
            <span></span>
          </div>
        </section>

        <section class="side-section" aria-labelledby="experience-heading">
          <h2 id="experience-heading">Experiencia</h2>
          <div class="experience-placeholder" aria-hidden="true">
            <span class="placeholder-icon" aria-hidden="true">✦</span>
            <span class="skeleton-line"></span>
            <span class="skeleton-line short"></span>
          </div>
        </section>
      </aside>

      <section class="projects-column" aria-labelledby="projects-heading">
        <div class="section-heading">
          <span class="eyebrow">Mi trabajo</span>
          <h2 id="projects-heading">Proyectos</h2>
        </div>

        <div class="project-cube" role="group" aria-label="Categorías de proyectos">
          <svg class="cube-drawing" viewBox="40 40 550 540" aria-hidden="true" focusable="false">
            <path class="cube-face cube-face--top" d="M90 240 230 80H550L390 240Z" />
            <path class="cube-face cube-face--right" d="M390 240 550 80V400L390 540Z" />
            {projectCategories.filter((category) => category.face === 'top').map((category) => (
              <path class={'cube-tile cube-tile--' + category.id} d={category.path} style={'--tile-color: ' + category.color} />
            ))}
            <g class="cube-lines">
              <path d="M90 240 230 80H550V400L390 540" />
              <path d="M550 80 390 240" />
              <path d="M240 230 390 80M164.375 155H475" />
              <path d="M400 390 550 240M475 155V465.625" />
            </g>
            <rect class="cube-face cube-face--front" x="80" y="230" width="320" height="320" rx="28" />
            {projectCategories.filter((category) => category.face === 'front').map((category) => (
              <path class={'cube-tile cube-tile--' + category.id} d={category.path} style={'--tile-color: ' + category.color} />
            ))}
            <g class="cube-lines">
              <rect x="80" y="230" width="320" height="320" rx="28" />
              <path d="M240 230V550M80 390H400" />
            </g>
          </svg>
          {projectCategories.map((category) => (
            <button
              class={'cube-button cube-button--' + category.id}
              id={'projects-' + category.id}
              type="button"
              style={'--tile-ink: ' + category.ink}
              data-project-category={category.id}
              aria-pressed="false"
            >
              <span class="cube-button-label">{category.name}</span>
            </button>
          ))}
        </div>
      </section>

      <aside class="skills-column" aria-labelledby="skills-heading">
        <div class="section-heading skills-heading">
          <span class="eyebrow">Tools</span>
          <h2 id="skills-heading">Skills</h2>
        </div>
        {skillSections.map((section) => (
          <section class="skill-group" aria-labelledby={section.id}>
            <h3 id={section.id}>{section.title}</h3>
            {section.groups.map((group) => (
              <div class="skill-subgroup">
                {group.title && <h4 id={group.id}>{group.title}</h4>}
                <ul class="skills-grid" aria-labelledby={group.title ? group.id : section.id}>
                  {group.skills.map((skill) => (
                    <li class={'skill-card' + (skill.description ? ' skill-card--detailed' : '')} style={'--skill-color: ' + skill.color}>
                      {skill.svg ? (
                        <span class="skill-logo" aria-hidden="true" set:html={skill.svg}></span>
                      ) : (
                        <span class="skill-logo skill-lettermark" aria-hidden="true">{skill.initials}</span>
                      )}
                      <span class="skill-name">{skill.name}</span>
                      {skill.description && <p class="skill-description">{skill.description}</p>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        ))}
      </aside>
    </main>
  </body>
</html>

<script>
  const categoryButtons = document.querySelectorAll<HTMLButtonElement>('[data-project-category]');

  categoryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectCategory = button.getAttribute('aria-pressed') !== 'true';

      categoryButtons.forEach((categoryButton) => {
        categoryButton.setAttribute('aria-pressed', String(categoryButton === button && selectCategory));
      });
    });
  });
</script>
